    "/api/records": {
      "get": {
        "tags": [
          "public"
        ],
        "summary": "List records",
        "description": "List records matching a set of conditions",
        "operationId": "listRecord",
        "parameters": [
          {
            "name": "text",
            "in": "query",
            "description": "Text query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "query",
            "description": "Name to query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "place",
            "in": "query",
            "description": "Place to query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "transcribed_text",
            "in": "query",
            "description": "Transcribed text to query must be combined with only_digitised_materials=true.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "year_min",
            "in": "query",
            "description": "Date from query (year)",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "year_max",
            "in": "query",
            "description": "Date to query (year, should be equal to or greater than year_from if both are present)",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "only_digitised_materials",
            "in": "query",
            "description": "Only digitised materials to query",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "facet",
            "in": "query",
            "description": "Facet queries, format {facet name}:{value}[;{facet name}:{value}]...",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Sort order",
            "schema": {
              "enum": [
                "relevance",
                "alphaAsc",
                "alphaDesc",
                "timeAsc",
                "timeDesc"
              ],
              "type": "string",
              "default": "relevance"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Pagination offset",
            "schema": {
              "type": "integer",
              "default": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Max number of records per page",
            "schema": {
              "type": "integer",
              "default": 100
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Incorrect parameters",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ErrorResult"
                  }
                },
                "example": {
                  "code": "InvalidParameter",
                  "message": "string"
                }
              }
            }
          },
          "200": {
            "description": "Wrapped list of records",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Result"
                  }
                },
                "example": {
                  "totalHits": 5,
                  "hits": 3,
                  "offset": 0,
                  "items": [
                    {
                      "type": "Fonds",
                      "metadata": {
                        "referenceCode": "string",
                        "hierarchy": [
                          {
                            "caption": "string",
                            "uri": "http://data.riksarkivet.se/archive/B1HtLX4z1g1HmweyFEyN8C"
                          }
                        ],
                        "partOf": [
                          {
                            "caption": "string",
                            "uri": "http://data.riksarkivet.se/tora/12345",
                            "date": "string"
                          }
                        ],
                        "provenance": [
                          {
                            "caption": "string",
                            "uri": "http://data.riksarkivet.se/agent/B1HtLX4z1g1HmweyFEyN8C",
                            "date": "string"
                          }
                        ],
                        "archivalInstitution": [
                          {
                            "caption": "string",
                            "uri": "http://data.riksarkivet.se/agent/B1HtLX4z1g1HmweyFEyN8C",
                            "date": "string"
                          }
                        ],
                        "date": "1586 – 1999",
                        "note": "string",
                        "onlyDigitisedMaterials": true
                      },
                      "id": "B1HtLX4z1g1HmweyFEyN8C",
                      "objectType": "RecordSet",
                      "caption": "string",
                      "_links": {
                        "self": "http://data.riksarkivet.se/archive/B1HtLX4z1g1HmweyFEyN8C",
                        "html": "https://sok.riksarkivet.se/arkiv/B1HtLX4z1g1HmweyFEyN8C",
                        "rdf/xml": "http://data.riksarkivet.se/archive/B1HtLX4z1g1HmweyFEyN8C.rdfxml",
                        "json-ld": "http://data.riksarkivet.se/archive/B1HtLX4z1g1HmweyFEyN8C.jsonld",
                        "ead/ra": "https://oai-pmh.riksarkivet.se/OAI/?verb=GetRecord&identifier=SE/ABC/12345&metadataPrefix=oai_ra_ead",
                        "ead/ape": "https://oai-pmh.riksarkivet.se/OAI/?verb=GetRecord&identifier=SE/ABC/12345&metadataPrefix=oai_ra_ead",
                        "image": [
                          "https://lbiiif.riksarkivet.se/000000/manifest",
                          "https://lbiiif.riksarkivet.se/A00000/manifest"
                        ]
                      }
                    }
                  ],
                  "_links": {
                    "self": "https://data.riksarkivet.se/api/records?text=getkant&offset=1&limit=2",
                    "next": "https://data.riksarkivet.se/api/records?text=getkant&offset=3&limit=2",
