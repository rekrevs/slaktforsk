    "/api/version": {
      "get": {
        "tags": [
          "admin"
        ],
        "summary": "Get current API version",
        "operationId": "getVersion",
        "responses": {
          "200": {
            "description": "API version",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiVersion"
                },
                "example": {
                  "apiName": "Riksarkivet Sök-API",
                  "apiVersion": "1.0.0.1",
                  "apiReleased": "2024-01-01",
                  "apiDocumentation": "https://github.com/Riksarkivet/dataplattform/wiki/S%C3%B6k-API",
                  "apiStatus": "active"
                }
              }
            }
          }
        }
      }
    },
    "/api/records/birthrecords": {
      "get": {
        "tags": [
          "public"
        ],
        "summary": "List birth records",
        "description": "List birth records matching a set of conditions",
        "operationId": "listBirthRecords",
        "parameters": [
          {
            "name": "first_name",
            "in": "query",
            "description": "First name to query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "place",
            "in": "query",
            "description": "Place to query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fathers_name",
            "in": "query",
            "description": "Father's name to query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "mothers_name",
            "in": "query",
            "description": "Mother's name to query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "baptismal_witness",
            "in": "query",
            "description": "Baptismal witness to query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "gender",
            "in": "query",
            "description": "Gender to query",
            "schema": {
              "enum": [
                "Kvinna",
                "Man",
                "Okänt"
              ],
              "type": "string"
            }
          },
          {
            "name": "year_min",
            "in": "query",
            "description": "Date to query (year)",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "year_max",
            "in": "query",
            "description": "Date to query (year, should be equal to or greater than year_from if both are present)",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Sort order",
            "schema": {
              "enum": [
                "first_name",
                "date"
              ],
              "type": "string",
              "default": "first_name"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Pagination offset",
            "schema": {
              "type": "integer",
              "default": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Max number of records per page",
            "schema": {
              "type": "integer",
              "default": 100
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Incorrect parameters",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ErrorResult"
                  }
                },
                "example": {
                  "code": "InvalidParameter",
                  "message": "string"
                }
              }
            }
          },
          "200": {
            "description": "Wrapped list of records",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Result"
                  }
                },
                "example": {
                  "totalHits": 5,
                  "hits": 1,
                  "offset": 0,
                  "items": [
                    {
                      "type": "IndexOfTitleDeedsRecord",
                      "metadata": {
                        "parish": "string",
                        "propertyName": "string",
                        "taxUnit": "string",
                        "year": "string",
                        "districtCourtSessions": "string"
                      },
                      "id": "B1HtLX4z1g1HmweyFEyN8C",
                      "objectType": "Register",
                      "caption": "string",
                      "_links": {
                        "self": "https://data.riksarkivet.se/register/J65dPc5oT5yPd9gOd1"
                      }
                    }
                  ],
                  "_links": {
                    "self": "https://data.riksarkivet.se/api/records?text=havdhem&offset=1&limit=2",
                    "next": "https://data.riksarkivet.se/api/records?text=havdhem&offset=3&limit=2",
                    "previous": "https://data.riksarkivet.se/api/records?text=havdhem&offset=0&limit=2"
                  }
                }
              }
            }
          }
        }
      }
    },
