          "hits": {
            "type": "integer",
            "format": ""
          },
          "offset": {
            "type": "integer",
            "format": ""
          },
          "facets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Facet"
            },
            "nullable": true
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ResultItemBase"
            }
          },
          "_links": {
            "$ref": "#/components/schemas/ResultLinks"
