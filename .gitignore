.DS_Store
**/.DS_Store

# Agent and local process state
.claude/
**/.claude/

# Authentication, downloads, crops, and other transient research state
tmp/

# Reproducible render-review output; retain the final PDF separately
output/family-edition-assets/
output/pdf/render-*/

# Language and tool caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
node_modules/
.venv/

# Genealogy2 runtime database and disposable verification copies.
# Durable exports and the exact import baseline remain versionable.
genealogy2/data/*.sqlite
genealogy2/data/*.sqlite-*
# Parked dump experiments (T-0665); retained locally, not recovery inputs.
genealogy2/backups/
genealogy2/backup.sh
genealogy2/verification/*
# Keep verification code and compact results; disposable databases, exports
# and restored trees remain ignored.
!genealogy2/verification/*.mjs
!genealogy2/verification/*-result.json
!genealogy2/verification/T-*.md
# Locked source-audit plan, sample and compact review evidence (T-0110).
!genealogy2/verification/T-0110/
!genealogy2/verification/T-0110/**
genealogy2/migration/pilot-coverage.json
# Consolidation audit evidence and checks (T-0115).
!genealogy2/verification/T-0115/
!genealogy2/verification/T-0115/**
