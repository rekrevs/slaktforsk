  "boundary_notes": [
    "Målklammer omfattar Per Wilhelm, hustru, son och dotter.",
    "Gustaf Rikard Hansson, Dräng1873 Hyrkefalla Skarab., ligger omedelbart ovan men föregående klammer slutar vid honom; ingen familjeanknytning tillskrivs.",
    "Små svarta märken nära kol4 på barnrader bevaras som gränsbläck, ingen lytebestämning."
  ],
  "uncertainties": [
    "Ort läses Hyrkefalla med reservation om handskrift; ingen extern ortnormalisering."
  ],
