        "property": "household_membership",
        "value_type": "structured",
        "value_json": "{\"places\":[{\"name\":\"Östanträsk, Sävar\",\"pages\":\"A I/6b s. 461\",\"years\":\"1870–1873\"},{\"name\":\"Brännmark, Sävar\",\"pages\":\"A I/6b s. 415; A I/7b s. 445\",\"years\":\"1873–1880\"},{\"name\":\"Gunnismark, Sävar\",\"pages\":\"A I/7b s. 410; A I/8b s. 460 rad 9\",\"years\":\"1880–1889\"}],\"relatives\":[{\"context\":\"Sävar 1870–1885\",\"person\":\"P-0058\"},{\"context\":\"Sävar 1870–1889\",\"person\":\"P-0059\"},{\"context\":\"Sävar1870–1889; hans registrerade Alnödatum1889-05-21 fastställer inte att han reste dagen efter Charlotta, vars dag20/21 och datumräckvidd är reserverade.\",\"person\":\"P-0063\"},{\"context\":\"Sävar 1870–1878\",\"person\":\"P-0424\"},{\"context\":\"Sävar 1870–1875\",\"person\":\"P-0060\"},{\"context\":\"Sävar 1870–1876 och 1884–1887\",\"person\":\"P-0061\"},{\"context\":\"Sävar 1870–1885\",\"person\":\"P-0062\"}],\"transfers\":[{\"day_reserved\":true,\"destination_page\":\"415\",\"literal\":\"1873-11-23\"},{\"destination_page\":\"410\",\"literal\":\"1880-11-20\",\"with\":[\"P-0058\",\"P-0059\",\"P-0063\"]}]}"
