  "case": "E",
  "image_sha256": "0819912aa3975403b12c793454a3b6c14c7403bc2ee72ce4c2a698ea99283cd4",
  "scope": {
    "target": "Klammern från Per Wilhelm Eliasson till Clara Sofia: tio rader, familj och tre tjänstefolksrader",
    "bounds_original_px_approx": [
      20,
      205,
      787,
      447
    ],
    "household_mark": "1-liknande siffra och lång klammer till vänster omfattar samtliga tio rader.",
    "source_heading": "Sida 24. Utdrag ur Församlingsboken för Wersås annex förs. i Fägre[?] kontrakt, Skaraborgs län, d. 31/12 1900.",
    "residence": "Ingen utskriven by-/gårdsrubrik synlig för målgruppen på denna sida; fylls inte från äldre källor."
  },
  "headers": {
    "left": "Hushållens antal/nummer",
    "1": "By eller lägenhet (qvarter eller rote i stad). (Bynamnet skrifves på särskild rad och understrykes.) Namn (fullständigt) å hvarje person; familjeställning (h. = hustru, s. = son, d. = dotter o. s. v.); titel (om annan än den i kol. 2 angifna); icke döpt.",
    "2": "Yrke (tjenst, näringsfång). Stam (främmande). Lyte (fallandesjuka, sinnessjuka, idioti, blind, döfstum).",
    "3–5": "Födelse-år; ort (församling i län eller i stad).",
    "7–8": "Ogift m./q.; Gift m./q.; Enkling; Enka; Frånskild m./q.",
    "14": "Trosbekännelse (främmande). Utträde ur Svenska kyrkan. Nationalitet (främmande). Frånvarande."
  },
